---
import type { Settings } from '../lib/data';

interface Props { s: Settings; }
const { s } = Astro.props;

const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Beranda', key: 'beranda' },
  { href: '/#program', label: 'Program', key: 'program' },
  { href: '/#visi-misi', label: 'Visi Misi', key: 'visi' },
  { href: '/#prestasi', label: 'Prestasi', key: 'prestasi' },
  { href: '/#kontak', label: 'Kontak', key: 'kontak' },
  { href: '/pengurus', label: 'Pengurus', key: 'pengurus' },
];
const donasi = '/#kontak';
---

{s.banner_teks && (
  <div class="banner"><div class="wrap"><span>{s.banner_teks}</span></div></div>
)}

<header class="nav" id="main-nav">
  <div class="wrap">
    <a href="/" class="brand" aria-label="Ke beranda">
      

<span class:list={['brand-logo', s.logo_url && 'has-custom-logo']}>
  {s.logo_url ? (
    <img
      src={s.logo_url}
      alt={`Logo ${s.nama_yayasan}`}
      class="site-logo-img"
    />
  ) : (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3 1 8.5 12 14l8-4v6h2V8.5zM5 13.3V17c0 1.7 3.1 3 7 3s7-1.3 7-3v-3.7l-7 3.5z"/>
    </svg>
  )}
</span>
<span class="brand-text">
  <strong>{s.nama_yayasan}</strong>
</span>

    </a>

    <!-- MENU DESKTOP -->
    <nav id="menu-desktop" class="nav-desktop" aria-label="Menu utama">
      {links.map((l) => {
        const isActive = currentPath === l.href || currentPath === l.href + '/';
        return (
          <a href={l.href} class={isActive ? 'active nav-link' : 'nav-link'}>
            {l.label}
          </a>
        )
      })}
    </nav>

    <div id="cta-desktop" class="nav-cta">
      <a class="btn btn-outline" href="/#kontak">Hubungi Kami</a>
      <a class="btn btn-primary" href={donasi}>Donasi Sekarang</a>
    </div>

    <!-- TOMBOL BURGER HP -->
    <button class="burger" id="burger" aria-label="Buka menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"><path class="l1" d="M4 7h16" /><path class="l2" d="M4 12h16" /><path class="l3" d="M4 17h16" /></svg>
    </button>
  </div>
  
  <!-- MENU MOBILE -->
  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-links">
      {links.map((l, i) => {
        const isActive = currentPath === l.href || currentPath === l.href + '/';
        return (
          <a href={l.href} class={isActive ? 'active nav-link' : 'nav-link'} style={`--i:${i}`}>
            <span>{l.label}</span>
            <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
          </a>
        )
      })}
    </div>
    <div class="mobile-actions">
      <a class="btn btn-outline" href="/#kontak">Hubungi Kami</a>
      <a class="btn btn-primary" href={donasi}>Donasi Sekarang</a>
    </div>
  </div>
</header>

<!-- LATAR REDUP SAAT MENU HP TERBUKA -->
<div class="menu-overlay" id="menu-overlay"></div>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  const allNavLinks = document.querySelectorAll('.nav-link');
  const header = document.getElementById('main-nav');
  const overlay = document.getElementById('menu-overlay');

  // Ambil semua link (desktop + HP) yang href-nya cocok
  function linksWithHref(...hrefs: string[]) {
    return Array.from(allNavLinks).filter((link) =>
      hrefs.includes(link.getAttribute('href') ?? '')
    );
  }

  function updateActiveMenu() {
    const path = window.location.pathname;
    const hash = window.location.hash;
    const fullUrl = path + hash;

    allNavLinks.forEach((link) => link.classList.remove('active'));

    // Halaman Galeri tetap menandai menu Prestasi
    if (path === '/galeri' || path === '/galeri/') {
      linksWithHref('/#prestasi').forEach((link) => {
        link.classList.add('active');
      });
      return;
    }

    let activeLinks = linksWithHref(fullUrl);

    if (!activeLinks.length) {
      activeLinks = linksWithHref(path, path + '/');
    }

    if (path === '/' && hash === '') {
      linksWithHref('/').forEach((link) => link.classList.add('active'));
    } else {
      activeLinks.forEach((link) => link.classList.add('active'));
    }
  }

  updateActiveMenu();
  window.addEventListener('hashchange', updateActiveMenu);

  // Langsung arahkan ke bagian Kontak setelah halaman Beranda dimuat
  function scrollToContact() {
    const isHome =
      window.location.pathname === '/' ||
      window.location.pathname === '';

    if (!isHome || window.location.hash !== '#kontak') return;

    const target = document.getElementById('kontak');

    if (!target) return;

    const navHeight = header?.getBoundingClientRect().height ?? 0;

    const targetPosition =
      target.getBoundingClientRect().top +
      window.scrollY -
      navHeight -
      8;

    window.scrollTo({
      top: Math.max(0, targetPosition),
      behavior: 'auto'
    });
  }

  // Tunggu halaman selesai dimuat agar target Kontak sudah siap
  if (document.readyState === 'complete') {
    requestAnimationFrame(scrollToContact);
  } else {
    window.addEventListener(
      'load',
      () => {
        requestAnimationFrame(scrollToContact);
      },
      { once: true }
    );
  }

  // Buka / tutup menu HP
  function setMenu(open: boolean) {
    menu?.classList.toggle('open', open);
    overlay?.classList.toggle('show', open);
    burger?.setAttribute('aria-expanded', String(open));
    burger?.setAttribute(
      'aria-label',
      open ? 'Tutup menu' : 'Buka menu'
    );

    document.body.style.overflow = open ? 'hidden' : '';
  }

  burger?.addEventListener('click', () =>
    setMenu(!menu?.classList.contains('open'))
  );

  overlay?.addEventListener('click', () => setMenu(false));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  // Kalau layar dilebarkan ke ukuran desktop, tutup menu HP
  window.matchMedia('(min-width: 993px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  allNavLinks.forEach((a) => {
    a.addEventListener('click', () => {
      setTimeout(updateActiveMenu, 10);
      setMenu(false);
    });
  });

  menu?.querySelectorAll('.mobile-actions a').forEach((a) => {
    a.addEventListener('click', () => setMenu(false));
  });

  // Sensor Scroll Terpadu
  function updateActiveOnScroll() {
    // Jangan mengubah menu aktif pada halaman selain Beranda
    if (window.location.pathname !== '/') return;

    const navHeight = header?.getBoundingClientRect().height ?? 0;
    const marker = window.scrollY + navHeight + 100;

    const sections = [
      { id: 'beranda', href: '/' },
      { id: 'program', href: '/#program' },
      { id: 'visi-misi', href: '/#visi-misi' },
      { id: 'prestasi', href: '/#prestasi' },
      { id: 'kontak', href: '/#kontak' }
    ];

    let activeHref = '/';

    sections.forEach((section) => {
      const element = document.getElementById(section.id);

      if (!element) return;

      const sectionTop =
        element.getBoundingClientRect().top + window.scrollY;

      if (sectionTop <= marker) {
        activeHref = section.href;
      }
    });

    // Jika sudah mencapai bagian paling bawah, aktifkan Kontak
    if (
      window.innerHeight + Math.round(window.scrollY) >=
      document.documentElement.scrollHeight - 50
    ) {
      activeHref = '/#kontak';
    }

    // Perbarui tanda aktif pada menu desktop dan mobile
    allNavLinks.forEach((link) => {
      link.classList.toggle(
        'active',
        link.getAttribute('href') === activeHref
      );
    });
  }

  window.addEventListener('scroll', () => {
    // Efek kaca saat navbar digulir
    if (window.scrollY > 20) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }

    // Perbarui menu sesuai bagian halaman yang terlihat
    updateActiveOnScroll();
  });

  // Atur menu aktif ketika halaman pertama kali dibuka
  updateActiveOnScroll();
</script>

<style is:global>
  /* ==========================================
     EFEK KACA (GLASSMORPHISM)
     ========================================== */
  header.nav {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background-color: #ffffff;
    transition: background-color 0.4s ease, backdrop-filter 0.4s ease, box-shadow 0.4s ease;
  }
  

  header.nav.scrolled {
    background-color: rgba(255, 255, 255, 0.7) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }

  header.nav .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 20px; /* Merapikan jarak atas bawah logo & menu */
  }

  /* ==========================================
     MENU DESKTOP
     ========================================== */
  .nav-desktop {
    display: flex !important;
    gap: 24px !important;
    align-items: center !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  .nav-link {
    position: relative;
    text-decoration: none !important;
    padding-bottom: 6px; 
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-weight: 600 !important; 
    font-size: 16px !important;  
    color: #1f2937 !important;   
    transition: color 0.3s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    width: 0; 
    height: 3px; 
    bottom: 0;
    left: 0; 
    background-color: #10b981; 
    border-radius: 4px;
    transition: width 0.4s ease-in-out; 
  }
  .nav-link:hover::after, .nav-link.active::after {
    width: 100%;
  }
  .nav-link:hover, .nav-link.active {
    color: #10b981 !important; 
  }

  /* Tombol Burger (Disembunyikan di Desktop) */
  .burger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    width: 32px;
    height: 32px;
    color: #1f2937;
  }

  /* ==========================================
     TAMPILAN MOBILE (HP)
     ========================================== */
  @media screen and (max-width: 992px) {
    /* 1. HILANGKAN MENU & TOMBOL DESKTOP */
    #menu-desktop,
    .nav-desktop,
    #cta-desktop {
      display: none !important;
      visibility: hidden !important;
      width: 0 !important;
      height: 0 !important;
      overflow: hidden !important;
    }

    /* 2. MUNCULKAN TOMBOL BURGER */
    header.nav .burger {
      display: flex !important;
      align-items: center;
      justify-content: center;
    }

    /* Garis tiga berubah jadi X saat menu terbuka */
    .burger path {
      transition: transform 0.3s ease, opacity 0.2s ease;
      transform-box: fill-box;
      transform-origin: center;
    }
    .burger[aria-expanded="true"] .l1 { transform: translateY(5px) rotate(45deg); }
    .burger[aria-expanded="true"] .l2 { opacity: 0; transform: scaleX(0.2); }
    .burger[aria-expanded="true"] .l3 { transform: translateY(-5px) rotate(-45deg); }

    /* 3. MENU MOBILE: KARTU MELAYANG */
    header.nav .mobile-menu {
      display: flex !important;
      flex-direction: column;
      gap: 6px;
      position: absolute;
      top: calc(100% + 8px);
      left: 12px;
      right: 12px;
      width: auto;
      max-height: calc(100vh - 110px);
      max-height: calc(100dvh - 110px);
      overflow-y: auto;
      padding: 10px;
      background-color: rgba(255, 255, 255, 0.98) !important;
      border: 1px solid #e5e7eb;
      border-radius: 20px;
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18) !important;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-10px) scale(0.98);
      transform-origin: top right;
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0.25s;
    }
    header.nav .mobile-menu.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s;
    }

    .mobile-links {
      display: grid;
      gap: 2px;
    }

    /* Baris menu */
    header.nav .mobile-menu .nav-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      margin: 0;
      padding: 14px 16px;
      border: none;
      border-radius: 12px;
      font-size: 16px !important;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.2s ease, color 0.3s ease;
    }
    header.nav .mobile-menu.open .nav-link {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--i, 0) * 35ms + 60ms), calc(var(--i, 0) * 35ms + 60ms), 0s, 0s;
    }
    header.nav .mobile-menu .nav-link::after {
      display: none;
    }
    /* Garis hijau kecil di kiri untuk menu yang aktif */
    header.nav .mobile-menu .nav-link::before {
      content: '';
      position: absolute;
      left: 0;
      top: 12px;
      bottom: 12px;
      width: 4px;
      border-radius: 0 4px 4px 0;
      background: #10b981;
      transform: scaleY(0);
      transition: transform 0.25s ease;
    }
    header.nav .mobile-menu .nav-link:hover {
      background-color: #f3f4f6;
    }
    header.nav .mobile-menu .nav-link.active {
      background-color: #ecfdf5;
      color: #047857 !important;
    }
    header.nav .mobile-menu .nav-link.active::before {
      transform: scaleY(1);
    }
    .mobile-menu .chev {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: 0.4;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .mobile-menu .nav-link:hover .chev { transform: translateX(3px); opacity: 0.8; }
    .mobile-menu .nav-link.active .chev { opacity: 1; }

    /* Dua tombol di bawah */
    header.nav .mobile-menu .mobile-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-top: 6px;
      padding: 12px 6px 4px;
      border-top: 1px solid #eef0f4;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    header.nav .mobile-menu.open .mobile-actions {
      opacity: 1;
      transform: none;
      transition-delay: 0.3s;
    }
    header.nav .mobile-menu .mobile-actions .btn {
      display: flex;
      justify-content: center;
      width: 100%;
      margin: 0;
      padding: 13px 8px;
      border: 1.5px solid var(--primary);
      font-size: 0.88rem;
      white-space: nowrap;
    }

    /* Latar redup di belakang menu */
    .menu-overlay {
      position: fixed;
      inset: 0;
      z-index: 999;
      background: rgba(15, 23, 42, 0.35);
      -webkit-backdrop-filter: blur(3px);
      backdrop-filter: blur(3px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0s linear 0.25s;
    }
    .menu-overlay.show {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.25s ease, visibility 0s;
    }
  }

  /* Layar HP sangat sempit: tombol disusun ke bawah supaya tidak terpotong */
  @media screen and (max-width: 360px) {
    header.nav .mobile-menu .mobile-actions {
      grid-template-columns: 1fr;
    }
    
/* Memberikan ruang untuk navbar pada tampilan HP */
@media screen and (max-width: 992px) {
  header.nav .wrap {
    min-height: 76px;
    box-sizing: border-box;
  }

  html {
    scroll-padding-top: 76px;
  }
}
  }
</style>