---
import '../../styles/global.css';
import '../../styles/admin.css';

export const prerender = true;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Reset Password · Yayasan Pena Alkarim</title>
    <link rel="icon" href="/favicon.png" />
  </head>
  <body class="admin">
    <main class="login-side" style="min-height: 100vh">
      <section class="login-card" aria-labelledby="reset-title">
        <h1 id="reset-title">Reset password</h1>
        <p class="sub" id="reset-status" role="status" aria-live="polite">Memeriksa tautan pemulihan…</p>
        <form id="request-form" hidden>
          <div class="fld">
            <label for="reset-email">Email admin</label>
            <input class="input" id="reset-email" name="email" type="email" autocomplete="username" required />
          </div>
          <button class="btn btn-primary btn-block" type="submit">Kirim tautan reset</button>
        </form>
        <form id="password-form" hidden>
          <div class="fld">
            <label for="new-password">Password baru</label>
            <input class="input" id="new-password" name="password" type="password" autocomplete="new-password" minlength="8" required aria-describedby="password-hint" />
            <small id="password-hint">Minimal 8 karakter. Gunakan password yang kuat dan belum pernah dipakai.</small>
          </div>
          <div class="fld">
            <label for="confirm-password">Konfirmasi password baru</label>
            <input class="input" id="confirm-password" name="confirmation" type="password" autocomplete="new-password" minlength="8" required />
          </div>
          <button class="btn btn-primary btn-block" type="submit">Simpan password baru</button>
        </form>
        <a class="btn btn-ghost btn-block" href="/admin">Kembali ke login</a>
        <noscript><p>Aktifkan JavaScript untuk mereset password.</p></noscript>
      </section>
    </main>
    <script>
      import '../../scripts/reset-password';
    </script>
  </body>
</html>
