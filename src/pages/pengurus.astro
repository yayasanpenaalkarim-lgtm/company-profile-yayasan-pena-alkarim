---
import Layout from '../layouts/Layout.astro';
import { getSettings, getPengurus } from '../lib/data';

const [s, semua] = await Promise.all([
  getSettings(),
  getPengurus(),
]);

const pengurus = semua.filter((p) => p.kategori === 'pengurus');
const pengajar = semua.filter((p) => p.kategori === 'pengajar');
const totalAnggota = pengurus.length + pengajar.length;

const judulPengurus = s.pengurus_judul || 'Pengurus & Tenaga Pengajar';

const deskripsiPengurus =
  s.pengurus_deskripsi ||
  'Kenali pengurus dan tenaga pengajar yang berkomitmen mendampingi pendidikan, menanamkan akhlak, dan membangun generasi yang bermanfaat.';
---

<Layout
  title={`${judulPengurus} | ${s.nama_yayasan}`}
  description={deskripsiPengurus}
  s={s}
>
  <main class="team-page">
  <!-- ORNAMEN BACKGROUND GLOBAL -->
  <div class="global-ornaments" aria-hidden="true">
    <div class="parallax-shape o-dot-grid" data-speed="0.05"></div>
    <div class="parallax-shape o-ring-1" data-speed="-0.15"></div>
    <div class="parallax-shape o-ring-2" data-speed="0.1"></div>
    <div class="parallax-shape o-glow" data-speed="-0.08"></div>

    <!-- Aksen background -->
    <div class="parallax-shape shape-1" data-speed="0.15"></div>
    <div class="parallax-shape shape-2" data-speed="-0.1"></div>
    <div class="parallax-shape shape-3" data-speed="0.08"></div>

    <!-- Bintang tersebar dari atas sampai bawah -->
    <div class="parallax-shape o-star o-star-1" data-speed="0.4">✦</div>
    <div class="parallax-shape o-star o-star-2" data-speed="-0.3">✧</div>
    <div class="parallax-shape o-star o-star-3" data-speed="0.5">✦</div>
    <div class="parallax-shape o-star o-star-4" data-speed="-0.2">✧</div>
    <div class="parallax-shape o-star o-star-5" data-speed="0.3">✦</div>
    <!-- BINTANG TAMBAHAN -->
    <div class="parallax-shape o-star o-star-6" data-speed="-0.45">✦</div>
    <div class="parallax-shape o-star o-star-7" data-speed="0.35">✧</div>
    <div class="parallax-shape o-star o-star-8" data-speed="-0.25">✳</div>
    <div class="parallax-shape o-star o-star-9" data-speed="0.55">✦</div>
    <div class="parallax-shape o-star o-star-10" data-speed="-0.4">✧</div>
    <div class="parallax-shape o-star o-star-11" data-speed="0.3">✴</div>
    <div class="parallax-shape o-star o-star-12" data-speed="-0.5">✦</div>
    <div class="parallax-shape o-star o-star-13" data-speed="0.4">✧</div>

    <!-- ORNAMEN LINGKARAN TAMBAHAN -->
    <div class="parallax-shape o-ring-3" data-speed="0.2"></div>
    <div class="parallax-shape o-ring-4" data-speed="-0.3"></div>
    <!-- LINGKARAN BAGIAN TENGAH DAN BAWAH -->
    <div class="parallax-shape o-ring-5" data-speed="-0.25"></div>
    <div class="parallax-shape o-ring-6" data-speed="0.35"></div>
    <!-- PENDARAN TAMBAHAN -->
    <div class="parallax-shape o-glow-2" data-speed="0.12"></div>
    <div class="parallax-shape o-orb-1" data-speed="-0.2"></div>
    <div class="parallax-shape o-orb-2" data-speed="0.3"></div>
  </div>

  <!-- HEADER HALAMAN -->
  <section class="team-hero">
    <div class="team-wrap">
      <div class="hero-badge reveal-down">
        <span class="badge-icon">✧</span> Tim Yayasan Kami
      </div>

      <h1 class="reveal-up" style="--delay: 100ms;">
        {judulPengurus}
      </h1>

      <p class="hero-description reveal-up" style="--delay: 200ms;">
        {deskripsiPengurus}
      </p>
    </div>
  </section>

  <!-- DAFTAR TIM -->
  <section class="team-section">
    <div class="team-wrap">
        
        <header class="section-heading">
  <div class="heading-text">
    <h2 class="pilar-title">
  Pilar Penggerak Pendidikan.
</h2>

    <p class="pilar-description">
  Berdedikasi untuk mencetak generasi Qur'ani yang berakhlak mulia.
</p>
  </div>

  <span
    class="member-count reveal-right"
    style="--delay: 250ms;"
    data-member-count
  >
    {totalAnggota} Anggota
  </span>
</header>

        <!-- FILTER SLIDER DINAMIS -->
        <div class="team-filters reveal-up" style="--delay: 150ms;" aria-label="Filter anggota">
          <div class="filter-track">
            <div class="filter-indicator" id="filter-indicator"></div>
            <button class="filter-btn is-active" type="button" data-filter="semua">Semua</button>
            <button class="filter-btn" type="button" data-filter="pengurus">Pengurus</button>
            <button class="filter-btn" type="button" data-filter="pengajar">Pengajar</button>
          </div>
        </div>

        <!-- PENGURUS YAYASAN -->
        {pengurus.length > 0 && (
          <section class="team-group" data-team-group="pengurus">
            <div class="group-heading reveal-left">
              <h3>Pengurus Yayasan</h3>
              <div class="heading-line"></div>
            </div>

            <div class="people-grid">
              {pengurus.map((p, i) => (
                <article
                  class={`person-card ${i % 3 === 0 ? 'reveal-left' : i % 3 === 1 ? 'reveal-up' : 'reveal-right'}`}
                  data-person-card
                  data-category="pengurus"
                  style={`--delay: ${(i % 3) * 80}ms;`}
                >
                  <div class="card-bg-gradient"></div>
                  <div class="person-info">
                    <span class="person-role">{p.jabatan}</span>
                    <h4>{p.nama}</h4>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        <!-- TENAGA PENGAJAR -->
        {pengajar.length > 0 && (
          <section class="team-group" data-team-group="pengajar">
            <div class="group-heading reveal-left">
              <h3>Tenaga Pengajar</h3>
              <div class="heading-line"></div>
            </div>

            <div class="people-grid">
              {pengajar.map((p, i) => (
                <article
                  class={`person-card ${i % 3 === 0 ? 'reveal-right' : i % 3 === 1 ? 'reveal-up' : 'reveal-left'}`}
                  data-person-card
                  data-category="pengajar"
                  style={`--delay: ${(i % 3) * 80}ms;`}
                >
                  <div class="card-bg-gradient"></div>
                  <div class="person-info">
                    <span class="person-role">{p.jabatan}</span>
                    <h4>{p.nama}</h4>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        {totalAnggota === 0 && (
          <p class="empty-state reveal-up">Belum ada data pengurus dan tenaga pengajar.</p>
        )}

        <div class="team-message reveal-up" style="--delay: 150ms;">
          <div class="message-inner">
            <span class="sparkle">✦</span> Bersama mendidik, menanamkan akhlak, dan membangun generasi yang bermanfaat.
          </div>
        </div>
    </div>
    </section>
  </main>
</Layout>

<style>
/* =========================================
   FONDASI & WARNA ELEGAN
   ========================================= */

.team-page {
  --green: #0b6b35;
  --green-light: #e8f3ec;
  --ink: #2a332d;
  --muted: #7b8881;
  --bg-base: #f8faf9;
  --card-bg: rgba(255, 255, 255, 0.85);

  position: relative;
  isolation: isolate;
  color: var(--ink);
  background: var(--bg-base);
  overflow: hidden;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

.team-wrap {
  width: min(1080px, calc(100% - 40px));
  margin-inline: auto;
  position: relative;
  z-index: 10;
}

/* =========================================
   BACKGROUND ORNAMEN GLOBAL
   ========================================= */

.global-ornaments {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.team-hero,
.team-section {
  position: relative;
  z-index: 1;
}

.parallax-shape {
  position: absolute;
  border-radius: 50%;
  will-change: transform;
  pointer-events: none;
}

/* =========================================
   POLA TITIK GLOBAL
   ========================================= */

.o-dot-grid {
  top: -10%;
  left: -10%;
  width: 120%;
  height: 120%;
  background-image: radial-gradient(
    rgba(11, 107, 53, 0.08) 1.5px,
    transparent 1.5px
  );
  background-size: 35px 35px;
  -webkit-mask-image: radial-gradient(
    ellipse at center,
    #000 0%,
    transparent 65%
  );
  mask-image: radial-gradient(
    ellipse at center,
    #000 0%,
    transparent 65%
  );
}

/* =========================================
   LINGKARAN GLOBAL — SOFT TETAPI TERLIHAT
   ========================================= */

/* Lingkaran 1: kanan atas */
.global-ornaments .o-ring-1 {
  top: -50px;
  right: -100px;
  width: 350px;
  height: 350px;
  border: 1.5px dashed rgba(11, 107, 53, 0.16);
  background: transparent;
}

/* Lingkaran 2: kiri bawah */
.global-ornaments .o-ring-2 {
  bottom: 10%;
  left: 5%;
  width: 180px;
  height: 180px;
  border: 1px solid rgba(11, 107, 53, 0.13);
  background: transparent;
}

/* Lingkaran 3: sisi kiri tengah */
.global-ornaments .o-ring-3 {
  top: 38%;
  left: -110px;
  width: 260px;
  height: 260px;
  border: 1.5px dashed rgba(11, 107, 53, 0.15);
  background: transparent;
}

/* Lingkaran 4: sisi kanan bawah */
.global-ornaments .o-ring-4 {
  top: 75%;
  right: -130px;
  width: 320px;
  height: 320px;
  border: 1px solid rgba(11, 107, 53, 0.13);
  background: transparent;
}

/* Lingkaran 5: tengah halaman */
.global-ornaments .o-ring-5 {
  top: 48%;
  left: 43%;
  width: 260px;
  height: 260px;
  border: 1.5px dashed rgba(11, 107, 53, 0.15);
  background: transparent;
}

/* Lingkaran 6: bagian bawah */
.global-ornaments .o-ring-6 {
  bottom: 3%;
  left: 40%;
  width: 340px;
  height: 340px;
  border: 1px solid rgba(11, 107, 53, 0.13);
  background: transparent;
}

/* Lingkaran besar tambahan di kanan */
.global-ornaments .shape-2 {
  top: 30%;
  right: -10%;
  width: 600px;
  height: 600px;
  border: 1px dashed rgba(11, 107, 53, 0.11);
  background: transparent;
}

/* =========================================
   PENDARAN HIJAU
   ========================================= */

.o-glow {
  top: 15%;
  left: -150px;
  width: 500px;
  height: 500px;
  background: radial-gradient(
    circle,
    rgba(144, 213, 165, 0.12),
    transparent 65%
  );
  filter: blur(20px);
}

.o-glow-2 {
  top: 55%;
  right: -180px;
  width: 420px;
  height: 420px;
  background: radial-gradient(
    circle,
    rgba(144, 213, 165, 0.13),
    transparent 68%
  );
  filter: blur(25px);
}

/* =========================================
   AKSEN BACKGROUND TAMBAHAN
   ========================================= */

.shape-1 {
  top: 5%;
  left: -5%;
  width: 400px;
  height: 400px;
  background: radial-gradient(
    circle,
    rgba(11, 107, 53, 0.04),
    transparent 70%
  );
}

.shape-3 {
  top: 70%;
  left: 10%;
  width: 250px;
  height: 250px;
  background: radial-gradient(
    circle,
    rgba(144, 213, 165, 0.07),
    transparent 70%
  );
}

/* =========================================
   BULATAN CAHAYA KECIL
   ========================================= */

.o-orb-1 {
  top: 30%;
  left: 12%;
  width: 10px;
  height: 10px;
  background: rgba(11, 107, 53, 0.16);
  box-shadow: 0 0 24px 8px rgba(144, 213, 165, 0.1);
}

.o-orb-2 {
  top: 72%;
  right: 25%;
  width: 14px;
  height: 14px;
  background: rgba(11, 107, 53, 0.14);
  box-shadow: 0 0 28px 10px rgba(144, 213, 165, 0.1);
}

/* =========================================
   BINTANG GLOBAL
   ========================================= */

.o-star {
  color: rgba(11, 107, 53, 0.22);
  line-height: 1;
}

/* Sudut kiri atas */
.o-star-1 {
  top: 8%;
  left: 7%;
  font-size: 2rem;
}

/* Sudut kanan atas */
.o-star-2 {
  top: 10%;
  right: 8%;
  font-size: 1.5rem;
}

/* Area kiri atas-tengah */
.o-star-3 {
  top: 22%;
  left: 22%;
  font-size: 1.8rem;
}

/* Area kanan atas-tengah */
.o-star-4 {
  top: 29%;
  right: 20%;
  font-size: 2.2rem;
}

/* Sisi kiri */
.o-star-5 {
  top: 37%;
  left: 5%;
  font-size: 1.4rem;
}

/* Sisi kanan */
.o-star-6 {
  top: 43%;
  right: 7%;
  font-size: 1.6rem;
}

/* Tengah kiri */
.o-star-7 {
  top: 34%;
  left: 25%;
  font-size: 2.2rem;
}

/* Tengah kanan */
.o-star-8 {
  top: 40%;
  right: 8%;
  font-size: 1.8rem;
}

/* Area tengah */
.o-star-9 {
  top: 53%;
  right: 28%;
  font-size: 2rem;
}

/* Tengah kiri-bawah */
.o-star-10 {
  top: 61%;
  left: 35%;
  font-size: 1.4rem;
}

/* Sisi kiri bawah */
.o-star-11 {
  top: 75%;
  left: 12%;
  font-size: 2rem;
}

/* Sisi kanan bawah */
.o-star-12 {
  top: 80%;
  right: 8%;
  font-size: 1.7rem;
}

/* Sudut kanan bawah */
.o-star-13 {
  top: 93%;
  left: 65%;
  font-size: 2rem;
}

/* =========================================
   HEADER HERO
   ========================================= */

.team-hero {
  position: relative;
  padding: 120px 0 80px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  overflow: hidden;
}

.team-hero .team-wrap {
  z-index: 2;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 16px;
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(11, 107, 53, 0.1);
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--green);
  margin-bottom: 20px;
  backdrop-filter: blur(10px);
}

.team-hero h1 {
  max-width: 800px;
  margin: 0 0 16px;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.2;
  color: #1a221d;
}

.hero-description {
  max-width: 600px;
  color: var(--muted);
  font-size: 1.05rem;
  line-height: 1.6;
  margin: 0 auto;
  font-weight: 400;
}

/* =========================================
   SECTIONS & KEPALA BAGIAN
   ========================================= */

.team-section {
  padding: 10px 0 100px;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 50px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  padding-bottom: 24px;
}

.heading-text h2 {
  font-size: clamp(1.4rem, 2.5vw, 1.9rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  margin: 0 0 8px;
  color: #1a221d;
}

.heading-text p {
  color: var(--muted);
  font-size: 0.95rem;
  margin: 0;
}

.member-count {
  background: var(--green-light);
  color: var(--green);
  padding: 6px 16px;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 500;
}

/* =========================================
   FILTER SLIDER
   ========================================= */

.team-filters {
  display: flex;
  justify-content: center;
  margin-bottom: 50px;
}

.filter-track {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  width: min(100%, 420px);
  box-sizing: border-box;
  background: rgba(225, 233, 227, 0.5); /* Warna asli */
  padding: 4px;
  border-radius: 999px;
  backdrop-filter: blur(10px);
}
.filter-indicator {
  position: absolute;
  top: 4px;
  bottom: 4px;
  left: 4px;
  width: 0;
  background: #fff;
  border-radius: 999px;

  /* Cahaya neon hijau yang lembut */
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.05),
    inset 0 0 0 1px rgba(11, 107, 53, 0.10),
    0 0 8px rgba(11, 107, 53, 0.18),
    0 0 16px rgba(11, 107, 53, 0.08);

  transition:
    left 0.35s cubic-bezier(0.22, 1, 0.36, 1),
    width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.3s ease;

  z-index: 1;
  pointer-events: none;
}
.filter-btn {
  position: relative;
  z-index: 2;
  width: 100%;
  min-width: 0;
  padding: 10px 8px;
  border: none;
  border-radius: 999px;
  background: transparent;
  color: var(--muted); /* Warna teks asli */
  font-size: 0.9rem;
  font-weight: 500;
  white-space: nowrap;
  cursor: pointer;
  transition: color 0.3s ease;
}

.filter-btn.is-active {
  color: var(--green); /* Tetap hijau #0b6b35 */
  font-weight: 600;
}

.filter-btn.is-active {
  color: var(--green);
  font-weight: 600;
}

.filter-btn.is-active {
  color: var(--green);
  font-weight: 600;
}

/* =========================================
   KARTU PENGURUS & PENGAJAR
   ========================================= */

.team-group {
  margin-bottom: 60px;
}

.team-group[hidden],
.person-card[hidden] {
  display: none !important;
}

.group-heading {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
}

.group-heading h3 {
  font-size: 1.25rem;
  font-weight: 600;
  color: #3b473e;
  margin: 0;
  white-space: nowrap;
}

.heading-line {
  flex-grow: 1;
  height: 1px;
  background: linear-gradient(
    to right,
    rgba(11, 107, 53, 0.15),
    transparent
  );
}

.people-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
}

.person-card {
  position: relative;
  padding: 26px 24px;
  background: var(--card-bg);
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
  overflow: hidden;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.card-bg-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0) 20%,
    rgba(144, 213, 165, 0.08) 100%
  );
  opacity: 0;
  transition: opacity 0.4s ease;
  z-index: 0;
}

.person-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 30px -8px rgba(11, 107, 53, 0.1);
  border-color: rgba(11, 107, 53, 0.15);
}

.person-card:hover .card-bg-gradient {
  opacity: 1;
}

.person-info {
  position: relative;
  z-index: 2;
}

.person-role {
  display: inline-block;
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--green);
  margin-bottom: 6px;
}

.person-info h4 {
  font-size: 1.15rem;
  font-weight: 600;
  margin: 0;
  color: var(--ink);
  letter-spacing: -0.01em;
}

/* =========================================
   PESAN PENUTUP
   ========================================= */

.team-message {
  margin-top: 50px;
}

.message-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-align: center;
  padding: 16px 24px;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(223, 240, 227, 0.7) 100%
  );
  backdrop-filter: blur(12px);
  border: 1px solid rgba(11, 107, 53, 0.15);
  border-radius: 16px;
  color: #2a332d;
  font-weight: 500;
  font-size: 0.85rem;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
}

.sparkle {
  display: inline-block;
  color: var(--green);
  font-size: 0.95rem;
  animation: spin 5s linear infinite;
}

@keyframes spin {
  100% {
    transform: rotate(360deg);
  }
}

/* =========================================
   ANIMASI REVEAL GSAP
   ========================================= */
/* Deskripsi Pilar tersembunyi saat awal halaman */
.pilar-description {
  opacity: 0;
  visibility: hidden;
  will-change: opacity, transform;
}
.reveal-up {
  transform: translateY(40px);
  opacity: 0;
}

.reveal-down {
  transform: translateY(-40px);
  opacity: 0;
}

.reveal-left {
  transform: translateX(-40px);
  opacity: 0;
}

.reveal-right {
  transform: translateX(40px);
  opacity: 0;
}

/* =========================================
   RESPONSIVE
   ========================================= */

@media (max-width: 768px) {
  .team-hero {
    padding: 90px 0 40px;
  }

  .section-heading {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
    padding-bottom: 20px;
  }

  .filter-btn {
  padding: 9px 4px;
  font-size: 0.82rem;
}

  .people-grid {
    grid-template-columns: 1fr;
  }

  /* Lingkaran */
  .global-ornaments .o-ring-1 {
    width: 220px;
    height: 220px;
  }

  .global-ornaments .o-ring-2 {
    width: 130px;
    height: 130px;
  }

  .global-ornaments .o-ring-3 {
