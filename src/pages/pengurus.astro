<!-- Memuat GSAP & ScrollTrigger dari CDN -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
<script>
  declare const gsap: any;
  declare const ScrollTrigger: any;

  function initTeamPage() {
    const page = document.querySelector<HTMLElement>('.team-page');

    if (!page || page.dataset.gsapReady === 'true') return;
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

    page.dataset.gsapReady = 'true';

    gsap.registerPlugin(ScrollTrigger);

    /* =========================================
       FILTER ANGGOTA
       ========================================= */

    const filterButtons = Array.from(
      page.querySelectorAll<HTMLButtonElement>('[data-filter]')
    );

    const teamGroups = Array.from(
      page.querySelectorAll<HTMLElement>('[data-team-group]')
    );

    const memberCount = page.querySelector<HTMLElement>('[data-member-count]');
    const indicator = page.querySelector<HTMLElement>('#filter-indicator');

    function updateIndicator(button: HTMLButtonElement) {
      if (!indicator) return;

      indicator.style.width = `${button.offsetWidth}px`;
      indicator.style.left = `${button.offsetLeft}px`;
    }

    const initialButton = page.querySelector<HTMLButtonElement>(
      '.filter-btn.is-active'
    );

    if (initialButton) {
      requestAnimationFrame(() => updateIndicator(initialButton));
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter || 'semua';
        let visibleTotal = 0;

        filterButtons.forEach((item) => {
          item.classList.toggle('is-active', item === button);
        });

        updateIndicator(button);

        teamGroups.forEach((group) => {
          const cards = Array.from(
            group.querySelectorAll<HTMLElement>('[data-person-card]')
          );

          let visibleInGroup = 0;

          cards.forEach((card) => {
            const visible =
              filter === 'semua' || card.dataset.category === filter;

            card.hidden = !visible;

            if (visible) {
              visibleInGroup++;
              visibleTotal++;
            }
          });

          group.hidden = visibleInGroup === 0;
        });

        if (memberCount) {
          memberCount.textContent = `${visibleTotal} Anggota`;
        }

        requestAnimationFrame(() => {
  ScrollTrigger.refresh();
});
      });
    });

    window.addEventListener('resize', () => {
      const activeButton = page.querySelector<HTMLButtonElement>(
        '.filter-btn.is-active'
      );

      if (activeButton) updateIndicator(activeButton);
    });

    /* =========================================
       PARALLAX ORNAMEN GLOBAL
       Bergerak mengikuti scroll seluruh halaman
       ========================================= */

    const ornaments = page.querySelectorAll<HTMLElement>(
      '.global-ornaments .parallax-shape'
    );

    ornaments.forEach((shape) => {
      const speed =
  Number.parseFloat(shape.dataset.speed || '0.1') * 3;

gsap.to(shape, {
  y: () => window.innerHeight * speed,
  x: () => window.innerWidth * speed * 0.15,
  rotation: speed * 35,
  ease: 'none',
  scrollTrigger: {
    trigger: page,
    start: 'top top',
    end: 'bottom bottom',
    scrub: 1,
    invalidateOnRefresh: true
  }
});
    });

    /* =========================================
       ANIMASI REVEAL
       ========================================= */

    const reveals = page.querySelectorAll<HTMLElement>(
      '.reveal-up, .reveal-down, .reveal-left, .reveal-right'
    );

    reveals.forEach((element) => {
      const delay =
        Number.parseFloat(
          getComputedStyle(element).getPropertyValue('--delay')
        ) || 0;

      let xStart = 0;
      let yStart = 0;

      if (element.classList.contains('reveal-left')) xStart = -40;
      if (element.classList.contains('reveal-right')) xStart = 40;
      if (element.classList.contains('reveal-up')) yStart = 40;
      if (element.classList.contains('reveal-down')) yStart = -40;

      const animation = {
        opacity: 1,
        x: 0,
        y: 0,
        duration: 1.2,
        ease: 'expo.out',
        delay: delay / 1000
      };

      if (element.closest('.team-hero')) {
        gsap.fromTo(
          element,
          { opacity: 0, x: xStart, y: yStart },
          {
            ...animation,
            delay: delay / 1000 + 0.1
          }
        );
      } else {
        gsap.fromTo(
          element,
          { opacity: 0, x: xStart, y: yStart },
          {
            ...animation,
            scrollTrigger: {
              trigger: element,
              start: 'top 90%',
              toggleActions: 'play none play reverse'
            }
          }
        );
      }
    });
    /* =========================================
   FADE SCROLL DESKRIPSI PILAR
   Muncul saat scroll turun, berulang terus
   ========================================= */

const pilarDescription =
  page.querySelector<HTMLElement>('.pilar-description');

if (pilarDescription) {
  gsap.fromTo(
    pilarDescription,
    {
      autoAlpha: 0,
      y: 25
    },
    {
      autoAlpha: 1,
      y: 0,
      ease: 'none',
      immediateRender: true,
      scrollTrigger: {
        trigger: pilarDescription,
        start: 'top 90%',
        end: 'top 35%',
        scrub: 0.5,
        invalidateOnRefresh: true
      }
    }
  );
}

    /* =========================================
       PARALLAX TEKS HERO
       ========================================= */

    const hero = page.querySelector<HTMLElement>('.team-hero');
    const heroWrap = hero?.querySelector<HTMLElement>('.team-wrap');

    if (hero && heroWrap) {
      gsap.to(heroWrap, {
        y: 80,
        opacity: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: 1.2
        }
      });
    }

    requestAnimationFrame(() => {
  ScrollTrigger.refresh();
});
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTeamPage, { once: true });
  } else {
    initTeamPage();
  }
</script>
